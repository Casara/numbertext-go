; This file is for unifying the coding style for different editors and IDEs.
; More information at http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

# JSON / YAML
[*.{json,yaml,yml}]
indent_size = 2

# Markdown
[*.md]
# Because:
# - most formatters (like Prettier) use 2 spaces
# - lists can become inconsistent depending on the editor
indent_size = 2
max_line_length = 120
# double whitespace at end of line
# denotes a line break in Markdown
trim_trailing_whitespace = false

# Shell
[*.sh]
indent_size = 2

# Makefiles and Go files always use tabs for indentation
[{Makefile,*.go,.gitmodules}]
indent_style = tab
indent_size = 4

[go.{mod,sum}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Upstream data, synced verbatim (see data/SOURCE.md) - never reformatted.
[data/*.sor]
insert_final_newline = false
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

# Code generated by scripts/gen-locale-embeds.py - not hand-edited, but
# still real Go source, so the Go rule above already covers it correctly.
